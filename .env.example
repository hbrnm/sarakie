# FVIS environment variables — names and safe placeholders ONLY.
# Never commit real values. Real values live in Render env vars and GitHub Actions secrets.

# Telegram
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
# Comma-separated numeric Telegram user IDs (not usernames)
TELEGRAM_ALLOWED_USER_IDS=000000000

# Football data provider (candidate: API-Football)
API_FOOTBALL_KEY=replace-with-api-key

# Gemini (explanations only; optional — system must work without it)
GEMINI_API_KEY=replace-with-api-key
GEMINI_MODEL_ID=replace-with-model-id

# Supabase (server-side only; never expose to any client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Scheduler trigger (only if /internal/scan endpoint is enabled)
SCHEDULER_TRIGGER_SECRET=replace-with-random-secret
